[{"id":5056,"topic":"כפרות","text":"מתי נוהגים לעשות כפרות?","options":["אחרי יוה״כ","לפני ראש השנה","בהושענא רבה","לפני יום הכיפורים"],"answer":3,"hint":"זהו מנהג הכנה ליום הצום והכפרה.","explanation":"נוהגים לעשות כפרות לפני יום הכיפורים."},{"id":5057,"topic":"כפרות","text":"מה משמש לזכר בכפרות לפי החומר?","options":["תרנגול","תרנגולת","אין הבחנה","יונה"],"answer":0,"hint":"זכר מתאים לצורת הזכר של שם בעל החיים.","explanation":"לזכר משתמשים בתרנגול."},{"id":5058,"topic":"כפרות","text":"מה משמש לנקבה בכפרות?","options":["תרנגולת","אין הבחנה","תרנגול","שני תרנגולים"],"answer":0,"hint":"נקבה מתאימה לצורת הנקבה של שם בעל החיים.","explanation":"לנקבה משתמשים בתרנגולת."},{"id":5059,"topic":"כפרות","text":"כמה פעמים מסובבים את הכפרות סביב הראש?","options":["2","4","3","7"],"answer":2,"hint":"אל תתבלבל עם שבע ההקפות של הושענא רבה.","explanation":"לפי החומר מסובבים שלוש פעמים."},{"id":5060,"topic":"כפרות","text":"סביב מה מסובבים את הכפרות?","options":["הבימה","הגוף כולו","הראש","בית הכנסת"],"answer":2,"hint":"הפעולה מתוארת כמסלול קטן סביב חלק אחד בגוף.","explanation":"מסובבים את הכפרות סביב הראש."},{"id":5061,"topic":"כפרות","text":"איזה נוסח שייך לכפרות?","options":["שובה ישראל","אשמנו, בגדנו","ותן טל ומטר","זה חליפתי, תמורתי, כפרתי"],"answer":3,"hint":"שלוש המילים כולן מתארות החלפה וכפרה.","explanation":"אומרים 'זה חליפתי, זה תמורתי, זה כפרתי'."},{"id":5062,"topic":"כפרות","text":"מהו הסדר המתאים למנהג?","options":["וידוי ואז שופר","3 סיבובים עם הנוסח ואז שחיטה","שחיטה ואז 7 סיבובים","מנחה ואז תשליך"],"answer":1,"hint":"הסיבוב והנוסח באים לפני פעולת השחיטה.","explanation":"מסובבים שלוש פעמים תוך אמירת הנוסח ולאחר מכן שוחטים."},{"id":5063,"topic":"כפרות","text":"איזה בעל חיים מתאים לזכר?","options":["שניהם לפי בחירה","תרנגול","תרנגולת","יונה בלבד"],"answer":1,"hint":"השאלה בודקת התאמה מדויקת בין מין האדם למין בעל החיים.","explanation":"בחומר מצוין תרנגול לזכר."},{"id":5064,"topic":"כפרות","text":"כפרות: איזה משפט מדויק כולו?","options":["אחרי יוה״כ; סביב הבימה","לפני יוה״כ; זכר-תרנגול; 3 סיבובים","לפני ר״ה; זכר-תרנגולת; 7 סיבובים","ביוה״כ; 4 סיבובים"],"answer":1,"hint":"בדוק שלושה פרטים יחד: זמן, מין ומספר.","explanation":"לפני יוה״כ: תרנגול לזכר, תרנגולת לנקבה ושלושה סיבובים."},{"id":5065,"topic":"כפרות","text":"איזה מספר שייך לכפרות?","options":["49","3","18","7"],"answer":1,"hint":"זהו מספר הסיבובים סביב הראש.","explanation":"שלושה סיבובים שייכים למנהג הכפרות."}]