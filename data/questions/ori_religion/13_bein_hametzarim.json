[{"id":5135,"topic":"בין המצרים","text":"כמה זמן נמשכת תקופת בין המצרים?","options":["שבועיים","שלושה שבועות","שבעה שבועות","תשעה ימים"],"answer":1,"hint":"התקופה מכונה גם 'שלושת השבועות'.","explanation":"בין המצרים נמשך שלושה שבועות."},{"id":5136,"topic":"בין המצרים","text":"באיזה תאריך מתחילה התקופה?","options":["י״ז בתמוז","א׳ באב","ט״ז בתמוז","י״ח בתמוז"],"answer":0,"hint":"זהו יום צום החל באמצע תמוז.","explanation":"התקופה מתחילה בי״ז בתמוז."},{"id":5137,"topic":"בין המצרים","text":"באיזה מועד מסתיימת התקופה?","options":["ז׳ באב","ראש חודש אב","י׳ באב","תשעה באב"],"answer":3,"hint":"זהו צום החורבן המרכזי.","explanation":"בין המצרים מסתיים בתשעה באב."},{"id":5138,"topic":"בין המצרים","text":"איזה סוג מנהגים נוהגים בתקופה?","options":["מנהגי ראש השנה","מנהגי שמחה","מנהגי אבלות","מנהגי פורים"],"answer":2,"hint":"התקופה מציינת אירועים קשים של חורבן.","explanation":"נוהגים בה מנהגי אבלות."},{"id":5139,"topic":"בין המצרים","text":"על מה מתאבלים בימים אלה?","options":["יציאת מצרים","חטא העגל בלבד","מות תלמידי ר״ע בלבד","חורבן בית המקדש"],"answer":3,"hint":"סיום התקופה הוא צום שמציין את החורבן.","explanation":"עיקר האבלות הוא על חורבן בית המקדש."},{"id":5140,"topic":"בין המצרים","text":"בין המצרים: איזה תיאור מדויק?","options":["3 שבועות: י״ז בתמוז–ט׳ באב","7 שבועות: פסח–שבועות","9 ימים: מט״ו בתמוז","3 שבועות: ר״ח אב–ר״ה"],"answer":0,"hint":"זכור את שני הצומות התוחמים את התקופה.","explanation":"שלושה שבועות בין י״ז בתמוז לתשעה באב."},{"id":5141,"topic":"בין המצרים","text":"איזה זוג תאריכים מדויק?","options":["י״ז באב וט׳ באלול","י״ח בתמוז וי׳ באב","י״ז בתמוז וט׳ באב","ט״ז בתמוז וח׳ באב"],"answer":2,"hint":"התחלה היא צום בתמוז והסיום צום באב.","explanation":"י״ז בתמוז עד תשעה באב."},{"id":5142,"topic":"בין המצרים","text":"מהו הסדר הכרונולוגי הנכון?","options":["ר״ה ואז י״ז בתמוז","ט״ז בניסן ואז שבועות ואז תמוז","ט׳ באב ואז י״ז בתמוז","י״ז בתמוז ואז ט׳ באב"],"answer":3,"hint":"תמוז קודם לאב בלוח העברי.","explanation":"י״ז בתמוז קודם לתשעה באב."},{"id":5143,"topic":"בין המצרים","text":"איזו אינה הגדרת בין המצרים?","options":["תקופת אבלות","י״ז בתמוז עד ט׳ באב","שלושה שבועות","ר״ח אב עד ט׳ באב בלבד"],"answer":3,"hint":"אחת האפשרויות מתארת רק חלק קצר מהתקופה.","explanation":"ראש חודש אב עד תשעה באב הוא חלק מבין המצרים, לא כל התקופה."},{"id":5144,"topic":"בין המצרים","text":"'3 שבועות + אבלות + חורבן' מזהה:","options":["חול המועד","עשרת ימי תשובה","ספירת העומר","בין המצרים"],"answer":3,"hint":"חפש תקופה שמסתיימת בתשעה באב.","explanation":"זהו בין המצרים."},{"id":5145,"topic":"בין המצרים","text":"מה עומד במרכז מנהגי האבלות?","options":["חורבן בית המקדש","קרבן העומר","אי־קיום נדרים","חתימת הדין"],"answer":0,"hint":"הצום שבסוף התקופה מציין את אותו אירוע.","explanation":"האבלות קשורה לחורבן בית המקדש."},{"id":5146,"topic":"בין המצרים","text":"מהו היום הראשון בתקופה?","options":["ט״ז בתמוז","א׳ באב","י״ח בתמוז","י״ז בתמוז"],"answer":3,"hint":"המספר הוא 17 ולא יום סמוך לו.","explanation":"י״ז בתמוז פותח את בין המצרים."},{"id":5147,"topic":"בין המצרים","text":"בין המצרים: איזה משפט נכון כולו?","options":["7 שבועות מט״ז בניסן","3 שבועות מי״ז בתמוז עד ט׳ באב","תקופת סליחות לפני ר״ה","מתחיל בר״ח אב ל-3 שבועות"],"answer":1,"hint":"בדוק משך ושני קצות התקופה יחד.","explanation":"בין המצרים נמשך שלושה שבועות מי״ז בתמוז עד תשעה באב."},{"id":5148,"topic":"בין המצרים","text":"מה שגוי: 'בין המצרים נמשך 3 שבועות מט״ז בתמוז עד ט׳ באב'?","options":["3 שבועות","ט׳ באב","ט״ז בתמוז","עצם התקופה"],"answer":2,"hint":"ההתחלה מאוחרת/מוקדמת ביום אחד? זכור את צום י״ז בתמוז.","explanation":"התחלת התקופה היא י״ז בתמוז, לא ט״ז."},{"id":5149,"topic":"בין המצרים","text":"איזה צירוף מפריד נכון בין התקופות?","options":["עומר: 49 יום; בין המצרים: 3 שבועות","עומר: 3 שבועות; בין המצרים: 49 יום","שתיהן 49 יום","שתיהן מתחילות בניסן"],"answer":0,"hint":"אחת מחברת פסח לשבועות; השנייה מחברת שני צומות בקיץ.","explanation":"ספירת העומר היא 49 יום; בין המצרים שלושה שבועות."}]