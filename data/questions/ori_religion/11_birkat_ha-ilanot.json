[{"id":5110,"topic":"ברכת האילנות","text":"באיזה חודש נהוג לברך ברכת האילנות לפי החומר?","options":["אייר","סיוון","אדר","ניסן"],"answer":3,"hint":"זהו חודש האביב שבו חל פסח.","explanation":"החומר מציין את חודש ניסן."},{"id":5111,"topic":"ברכת האילנות","text":"ליד כמה עצי פרי מציין החומר לברך?","options":["שני עצי פרי","שבעה עצים","עץ אחד","שלושה עצים"],"answer":0,"hint":"למבחן זכור מספר זוגי קטן.","explanation":"לפי חומר המבחן מדובר בשני עצי פרי."},{"id":5112,"topic":"ברכת האילנות","text":"באיזה מצב צריכים העצים להיות?","options":["יבשים","עם פרי בשל בלבד","בשלכת","מלבלבים"],"answer":3,"hint":"מדובר בפריחה והתחדשות האביב.","explanation":"העצים צריכים להיות מלבלבים."},{"id":5113,"topic":"ברכת האילנות","text":"באיזה סוג עצים מדובר?","options":["עצי נוי","כל עץ","עצי סרק בלבד","עצי פרי"],"answer":3,"hint":"הברכה מתייחסת לעצים שמוציאים דבר שנאכל.","explanation":"בחומר מדובר בעצי פרי."},{"id":5114,"topic":"ברכת האילנות","text":"מה מבטאת הברכה?","options":["הודיה על יציאת מצרים","בקשה לגשם","הודיה על הטבע לצורך האדם","זכר לחורבן"],"answer":2,"hint":"הברכה קשורה להתחדשות הבריאה.","explanation":"היא מבטאת הודיה על בריאת הטבע לטובת האדם."},{"id":5115,"topic":"ברכת האילנות","text":"איזה תיאור מתאים לחומר?","options":["ניסן; 2 עצי פרי; מלבלבים","אייר; עץ אחד; בשל","ניסן; 7 עצים יבשים","תשרי; 2 עצי נוי"],"answer":0,"hint":"חבר חודש אביב, מספר קטן וסימן של פריחה.","explanation":"ניסן, שני עצי פרי מלבלבים."},{"id":5116,"topic":"ברכת האילנות","text":"איזה מספר צריך לזכור למבחן?","options":["3","7","1","2"],"answer":3,"hint":"לפי החוברת מחפשים זוג עצים.","explanation":"המספר בחומר הוא שני עצי פרי."},{"id":5117,"topic":"ברכת האילנות","text":"איזה פרט אינו שייך לתשליך אלא לברכת האילנות?","options":["ראש השנה","עצי פרי מלבלבים","אחרי מנחה","מקור מים"],"answer":1,"hint":"שלוש אפשרויות מזהות תשליך; אחת שייכת לאביב.","explanation":"עצי פרי מלבלבים שייכים לברכת האילנות."},{"id":5118,"topic":"ברכת האילנות","text":"איזה צירוף נכון כולו?","options":["ניסן + עץ 1 + פרי בשל","ניסן + 2 עצי פרי + לבלוב","תשרי + 2 עצים + 7 הקפות","סיוון + 2 עצים + מתן תורה"],"answer":1,"hint":"כל שלושת הפרטים נלקחים מאותה הגדרה בחוברת.","explanation":"ניסן, שני עצי פרי, כשהם מלבלבים."},{"id":5119,"topic":"ברכת האילנות","text":"'ניסן + שני עצי פרי מלבלבים' מזהה:","options":["ספירת העומר","שמחת בית השואבה","תשליך","ברכת האילנות"],"answer":3,"hint":"זהו מנהג של התחדשות האביב.","explanation":"זהו תיאור ברכת האילנות."}]