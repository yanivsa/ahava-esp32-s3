[{"id":5078,"topic":"תפילת נעילה","text":"מהי תפילת נעילה ביחס לתפילות יום הכיפורים?","options":["התפילה הפותחת","תפילת הבוקר","תפילת חול המועד","התפילה המסיימת"],"answer":3,"hint":"שמה מרמז על סיום וסגירה.","explanation":"נעילה היא התפילה המסיימת את תפילות יום הכיפורים."},{"id":5079,"topic":"תפילת נעילה","text":"מהו הסבר אחד לשם 'נעילה'?","options":["נעילת שערי העיר","נעילת שערי ההיכל","נעילת ארון הקודש","נעילת בית הכנסת"],"answer":1,"hint":"אחד ההסברים קשור למקדש ולשעריו.","explanation":"החומר מזכיר את נעילת שערי ההיכל."},{"id":5080,"topic":"תפילת נעילה","text":"מהו ההסבר השני לשם 'נעילה'?","options":["נעילת שערי שמים","נעילת ספר התורה","נעילת הסוכה","נעילת ירושלים"],"answer":0,"hint":"זהו הסבר רוחני ולא פיזי.","explanation":"ההסבר השני הוא כביכול נעילת שערי שמים."},{"id":5081,"topic":"תפילת נעילה","text":"מה קורה לגזר הדין בזמן נעילה לפי החומר?","options":["נמחק","נכתב לראשונה","נדחה לשנה","נחתם"],"answer":3,"hint":"ראש השנה קשור לכתיבה; נעילה לסיום התהליך.","explanation":"בנעילה מודגשת חתימת גזר הדין."},{"id":5082,"topic":"תפילת נעילה","text":"איזו מילה אומרים במקום 'כתבנו' בנעילה?","options":["סלח לנו","מחלנו","זכרנו","חתמנו"],"answer":3,"hint":"השלב עבר מכתיבה לשלב הסופי.","explanation":"אומרים 'חתמנו' במקום 'כתבנו'."},{"id":5083,"topic":"תפילת נעילה","text":"היכן מופיע שינוי 'חתמנו' לפי החומר?","options":["באבינו מלכנו בלבד","בעמידה בלבד","בווידוי בלבד","בעמידה ובאבינו מלכנו"],"answer":3,"hint":"החומר מציין שני מקומות, לא אחד.","explanation":"השינוי מופיע בעמידה וב'אבינו מלכנו'."},{"id":5084,"topic":"תפילת נעילה","text":"מה נעשה בסיום תפילת נעילה?","options":["עושים 7 הקפות","אומרים תשליך","מתירים נדרים","תוקעים בשופר"],"answer":3,"hint":"זהו צליל המסמן את סיום יום הכיפורים.","explanation":"בסיום נעילה תוקעים בשופר."},{"id":5085,"topic":"תפילת נעילה","text":"איזה רצף מדויק?","options":["יוה״כ; חתמנו; שופר בסיום","ר״ה; כתבנו; 7 הקפות","סוכות; חתמנו; תשליך","ערב ר״ה; נדרים; שופר"],"answer":0,"hint":"כל שלושת הפרטים צריכים להשתייך לתפילת הסיום של יוה״כ.","explanation":"נעילה ביום הכיפורים כוללת לשון 'חתמנו' ושופר בסיום."},{"id":5086,"topic":"תפילת נעילה","text":"בנוסח נעילה עוברים מ־","options":["כתבנו לחתמנו","חתמנו לכתבנו","אשמנו לבגדנו","זכרנו לכתבנו"],"answer":0,"hint":"המעבר משקף מעבר מכתיבה לחתימה.","explanation":"בנעילה מחליפים 'כתבנו' ב'חתמנו'."},{"id":5087,"topic":"תפילת נעילה","text":"איזה פרט ייחודי לנעילה?","options":["יום תרועה","'חתמנו' במקום 'כתבנו'","תשליך ליד מים","7 הקפות"],"answer":1,"hint":"חפש שינוי נוסח שמבטא סיום דין.","explanation":"'חתמנו' הוא פרט מובהק של נעילה."},{"id":5088,"topic":"תפילת נעילה","text":"'תפילה אחרונה + חתימה + שופר' מזהה את:","options":["תשליך","שבת שובה","נעילה","סליחות"],"answer":2,"hint":"שלושת הרמזים כולם שייכים לסיום יום הכיפורים.","explanation":"זהו תיאור תפילת נעילה."},{"id":5089,"topic":"תפילת נעילה","text":"מה שגוי: 'בנעילה אומרים כתבנו במקום חתמנו ואז תוקעים'?","options":["עצם שינוי הנוסח","כיוון ההחלפה","תפילת נעילה","התקיעה"],"answer":1,"hint":"התקיעה נכונה; רק סדר המילים הוחלף.","explanation":"בנעליה אומרים 'חתמנו' במקום 'כתבנו'."}]