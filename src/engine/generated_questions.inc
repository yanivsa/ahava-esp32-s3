    {1157, 0, PROFILE_ORI, "פתרו את מערכת המשוואות הבאה: x + y = 10 וגם x - y = 4. מהו ערכם של x ו-y?", {"x = 7, y = 3", "x = 6, y = 4", "x = 8, y = 2", "x = 5, y = 5"}, 0, "נחבר את שתי המשוואות ונקבל 2x = 14, כלומר x = 7. נציב במשואה הראשונה 7 + y = 10 ונקבל y = 3."},
