    {1093, 1, PROFILE_ETHAN, "בַּמִּשְׁפָּט 'פִּתְאֹם צָץ רַעְיוֹן בְּרֹאשׁוֹ שֶׁל יוֹנָתָן', מָה פֵּרוּשׁ הַמִּלָּה 'צָץ'?", {"הוֹפִיעַ", "רָץ", "זָרַק", "בָּרַח"}, 0, "'צָץ' פֵּרוּשׁוֹ עָלָה אוֹ הוֹפִיעַ לְפֶתַע פִּתְאֹם.", "", 1},
    {1094, 1, PROFILE_ETHAN, "מַדּוּעַ הִצְלִיחַ יוֹנָתָן לִשְׁמֹעַ בַּלַּיְלָה אֶת רִשְׁרוּשׁ הָעָלִים שֶׁל הָעֵץ בַּחוּץ?", {"מִכֵּיוָן שֶׁהַחֲתוּלִים מְיַלְּלִים רַק בַּיּוֹם", "מִכֵּיוָן שֶׁבַּלַּיְלָה הָעָלִים זָזִים יוֹתֵר", "מִכֵּיוָן שֶׁבַּלַּיְלָה קָרִיר יוֹתֵר בַּחוּץ", "מִכֵּיוָן שֶׁבַּלַּיְלָה יֵשׁ שֶׁקֶט רָב בָּרְחוֹב"}, 3, "בַּלַּיְלָה הָרַעַשׁ שֶׁל הַיּוֹם שׁוֹקֵט וְיֵשׁ דְּמָמָה, וְלָכֵן קַל יוֹתֵר לִשְׁמֹעַ קוֹלוֹת חֲלָשִׁים כְּמוֹ רִשְׁרוּשׁ עָלִים.", "", 1},
    {1095, 1, PROFILE_ETHAN, "מִלִּים נִרְדָּפוֹת הֵן מִלִּים בַּעֲלוֹת מַשְׁמָעוּת דּוֹמָה. בְּאֵיזֶה צֶמֶד מִלִּים הַבָּא הַמִּלִּים אֵינָן מִלִּים נִרְדָּפוֹת?", {"דְּמָמָה - שֶׁקֶט", "נוֹצֵץ - זוֹהֵר", "שׁוֹקֵעַ - מַחְשִׁיךְ", "רֵיק - שׁוֹמֵם"}, 2, "'שׁוֹקֵעַ' (כְּמוֹ שֶׁמֶשׁ שׁוֹקַעַת) וְ'מַחְשִׁיךְ' אֵינָן מִלִּים נִרְדָּפוֹת מֻחְלָטוֹת, בְּעוֹד שֶׁשְּׁאָר הַצְּמָדִים מְתָאֲרִים כִּמְעַט אֶת אוֹתוֹ הַדָּבָר.", "", 1},
    {1096, 1, PROFILE_ETHAN, "קְרָא אֶת הַטֶּקְסְט וַעֲנֵה עַל הַשְּׁאֵלָה: \"הַזִּקִּית הִיא זוֹחֵל הַיָּדוּעַ בִּיכָלְתּוֹ לְשַׁנּוֹת אֶת צֶבַע עוֹרוֹ. הַזִּקִּית מַחֲל…", {"\"רַק כְּדֵי לְהִתְחַבֵּא מֵאוֹיְבִים\"", "\"כְּדֵי לִתְקַשֵּׁר וּלְוַסֵּת אֶת חֹם גּוּפָהּ\"", "\"כִּי מְשַׁעֲמֵם לָהּ בַּיַּעַר\"", "\"כְּדֵי לַעֲשׂוֹת קְסָמִים לְחַיּוֹת\""}, 1, "בַּטֶּקְסְט צֻיַּן מְפֹרָשׁוֹת כִּי שִׁנּוּי הַצֶּבַע מְשַׁמֵּשׁ לְתִקְשֹׁרֶת עִם זִקִּיּוֹת אֲחֵרוֹת וְלְוִסּוּת חֹם גּוּפָהּ.", "", 1},
