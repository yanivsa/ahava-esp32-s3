    {1098, 1, PROFILE_ETHAN, "קְרָא אֶת הַקֶּטַע: \"גַּל הָלַךְ בַּיַּעַר וְשָׁמַע תִּקְתּוּק מֵאֲחוֹרֵי שִׂיחַ סָבוּךְ. הוּא הֵזִיז אֶת הֶעָלִים בִּזְהִירוּת וְרָאָה עֲק…", {"\"שִׂמְחָה עֲצוּמָה\"", "\"שִׁעֲמוּם גָּדוֹל\"", "\"רְעָבוֹן לֶאֱכֹל מַשֶּׁהוּ\"", "\"סַקְרָנוּת וּמְעַט חֲשָׁשׁ\""}, 3, "כַּאֲשֶׁר שׁוֹמְעִים קוֹל לֹא מֻכָּר מֵאֲחוֹרֵי שִׂיחַ בַּיַּעַר, לָרֹב מַרְגִּישִׁים סַקְרָנוּת וַחֲשָׁשׁ מִפְּנֵי מַה שֶּׁמִּסְתַּתֵּר.", "", 1},
    {1099, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת הַמִּלָּה הֲכִי מַתְאִימָה לְהַשְׁלִים אֶת הַמִּשְׁפָּט: הַפַּרְפַּר מִתְעוֹפֵף מִפֶּרַח לְפֶרַח כְּדֵי _______ צוּף.", {"\"לָנוּחַ\"", "\"לִכְתּוֹב\"", "\"לִשְׁתּוֹת\"", "\"לַעֲצוֹד\""}, 2, "הַפַּרְפָּרִים אוֹסְפִים וְשׁוֹתִים צוף מִתּוֹךְ הַפְּרָחִים.", "", 1},
    {1100, 1, PROFILE_ETHAN, "מָה הַפֹּעַל הַמַּתְאִים בַּמִּשְׁפָּט לְשׁוֹן רַבִּים: אֶתְמוֹל, יְלָדִים רַבִּים _______ אֶת סִפְרֵי הַקֶּסֶם שֶׁלָּהֶם בַּסִּפְרִיָּה.", {"\"קָרָא\"", "\"קָרְאוּ\"", "\"קָרְאָה\"", "\"קוֹרֵא\""}, 1, "הַמִּלָּה \"יְלָדִים\" הִיא בְּלָשׁוֹן זָכָר רַבִּים. כֵּיוָן שֶׁמְּדֻבָּר בְּעָבָר (\"אֶתְמוֹל\"), הַפֹּעַל הַנָּכוֹן הוּא \"קָרְאוּ\".", "", 1},
    {1101, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת צוּרַת הַיָּחִיד שֶׁל הַמִּלָּה גְּלִימוֹת:", {"\"גְּלִימָה\"", "\"גָּלִים\"", "\"גְּלוּם\"", "\"גְּלוּמָה\""}, 0, "צוּרַת הַיָּחִיד שֶׁל \"גְּלִימוֹת\" (נְקֵבָה רַבִּים) הִיא \"גְּלִימָה\" (נְקֵבָה יָחִיד).", "", 1},
