    {1167, 0, PROFILE_ORI, "רכבת מהירה נוסעת מרחק של 150 ק\"מ במהירות קבועה של 60 קמ\"ש. כמה זמן נמשכת הנסיעה?", {"שעתיים וחצי", "שעתיים", "שלוש שעות", "שעה ושלושת רבעי"}, 0, "זמן שווה למרחק חלקי מהירות: 150 / 60 = 2.5 שעות (כלומר שעתיים וחצי)."},
