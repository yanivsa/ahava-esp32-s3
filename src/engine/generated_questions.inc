    {1092, 1, PROFILE_ETHAN, "בַּסִּפּוּר עַל יוֹנָתָן, הוּא אוֹמֵר לְהוֹרָיו: 'בַּלַּיְלָה הֲכִי כֵּף! אֶפְשָׁר לִרְאוֹת בַּחוּץ יַנְשׁוּפִים וַעֲטַלֵּפִים, כּוֹכָבִים…", {"כְּדֵי לְשַׁכְנֵעַ אוֹתָם שֶׁבַּלַּיְלָה אֶפְשָׁר…", "כְּדֵי לְהַזְכִּיר לָהֶם שֶׁהוּא אוֹהֵב חַיּוֹת ל…", "כְּדֵי לְסַפֵּר לָהֶם מָה רָאָה בַּלַּיְלָה הַקּו…", "כְּדֵי לְהַסְבִּיר לָהֶם שֶׁהַזְּרִיחָה מִתְרַחֶש…"}, 0, "יוֹנָתָן נִסָּה לְשַׁכְנֵעַ אֶת הַהוֹרִים שֶׁלּוֹ שֶׁלַּיְלָה הוּא זְמַן מְהַנֶּה וְלֹא רַק בִּזְבּוּז זְמַן בִּשֵׁנָה."},
    {1093, 1, PROFILE_ETHAN, "בַּמִּשְׁפָּט 'פִּתְאֹם צָץ רַעְיוֹן בְּרֹאשׁוֹ שֶׁל יוֹנָתָן', מָה פֵּרוּשׁ הַמִּלָּה 'צָץ'?", {"הוֹפִיעַ", "רָץ", "זָרַק", "בָּרַח"}, 0, "'צָץ' פֵּרוּשׁוֹ עָלָה אוֹ הוֹפִיעַ לְפֶתַע פִּתְאֹם."},
    {1094, 1, PROFILE_ETHAN, "מַדּוּעַ הִצְלִיחַ יוֹנָתָן לִשְׁמֹעַ בַּלַּיְלָה אֶת רִשְׁרוּשׁ הָעָלִים שֶׁל הָעֵץ בַּחוּץ?", {"מִכֵּיוָן שֶׁבַּלַּיְלָה יֵשׁ שֶׁקֶט רָב בָּרְחוֹב", "מִכֵּיוָן שֶׁבַּלַּיְלָה הָעָלִים זָזִים יוֹתֵר", "מִכֵּיוָן שֶׁבַּלַּיְלָה קָרִיר יוֹתֵר בַּחוּץ", "מִכֵּיוָן שֶׁהַחֲתוּלִים מְיַלְּלִים רַק בַּיּוֹם"}, 0, "בַּלַּיְלָה הָרַעַשׁ שֶׁל הַיּוֹם שׁוֹקֵט וְיֵשׁ דְּמָמָה, וְלָכֵן קַל יוֹתֵר לִשְׁמֹעַ קוֹלוֹת חֲלָשִׁים כְּמוֹ רִשְׁרוּשׁ עָלִים."},
    {1095, 1, PROFILE_ETHAN, "מִלִּים נִרְדָּפוֹת הֵן מִלִּים בַּעֲלוֹת מַשְׁמָעוּת דּוֹמָה. בְּאֵיזֶה צֶמֶד מִלִּים הַבָּא הַמִּלִּים אֵינָן מִלִּים נִרְדָּפוֹת?", {"שׁוֹקֵעַ - מַחְשִׁיךְ", "נוֹצֵץ - זוֹהֵר", "דְּמָמָה - שֶׁקֶט", "רֵיק - שׁוֹמֵם"}, 0, "'שׁוֹקֵעַ' (כְּמוֹ שֶׁמֶשׁ שׁוֹקַעַת) וְ'מַחְשִׁיךְ' אֵינָן מִלִּים נִרְדָּפוֹת מֻחְלָטוֹת, בְּעוֹד שֶׁשְּׁאָר הַצְּמָדִים מְתָאֲרִים כִּמְעַט אֶת אוֹתוֹ הַדָּבָר."},
    {1096, 1, PROFILE_ETHAN, "קְרָא אֶת הַטֶּקְסְט וַעֲנֵה עַל הַשְּׁאֵלָה: \"הַזִּקִּית הִיא זוֹחֵל הַיָּדוּעַ בִּיכָלְתּוֹ לְשַׁנּוֹת אֶת צֶבַע עוֹרוֹ. הַזִּקִּית מַחֲל…", {"\"כְּדֵי לִתְקַשֵּׁר וּלְוַסֵּת אֶת חֹם גּוּפָהּ\"", "\"רַק כְּדֵי לְהִתְחַבֵּא מֵאוֹיְבִים\"", "\"כִּי מְשַׁעֲמֵם לָהּ בַּיַּעַר\"", "\"כְּדֵי לַעֲשׂוֹת קְסָמִים לְחַיּוֹת\""}, 0, "בַּטֶּקְסְט צֻיַּן מְפֹרָשׁוֹת כִּי שִׁנּוּי הַצֶּבַע מְשַׁמֵּשׁ לְתִקְשֹׁרֶת עִם זִקִּיּוֹת אֲחֵרוֹת וְלְוִסּוּת חֹם גּוּפָהּ."},
    {1097, 1, PROFILE_ETHAN, "בַּמִּשְׁפָּט מִתּוֹךְ הַטֶּקְסְט: \"לְוַסֵּת אֶת חֹם גּוּפָהּ\", מָהוּ הַפֵּרוּשׁ שֶׁל הַמִּלָּה \"לְוַסֵּת\"?", {"\"לְהַתְאִים אוֹ לְכַוֵּן לָרָמָה הַנְּכוֹנָה\"", "\"לְכַבּוֹת לְגַמְרֵי\"", "\"לֶאֱסֹף אוֹכֶל עֲבוּר תְּקוּפַת הַחֹרֶף\"", "\"לִפְלֹט זֵעָה הַרְבֵּה יוֹתֵר יַחַסִית\""}, 0, "וִסּוּת פֵּרוּשׁוֹ שְׁלִיטָה וְהַתְאָמָה - כְּמוֹ וִסּוּת קְלִימָט כְּדֵי שֶׁלֹּא יִהְיֶה חַם מִדַּי אוֹ קַר מִדַּי."},
    {1098, 1, PROFILE_ETHAN, "קְרָא אֶת הַקֶּטַע: \"גַּל הָלַךְ בַּיַּעַר וְשָׁמַע תִּקְתּוּק מֵאֲחוֹרֵי שִׂיחַ סָבוּךְ. הוּא הֵזִיז אֶת הֶעָלִים בִּזְהִירוּת וְרָאָה עֲק…", {"\"סַקְרָנוּת וּמְעַט חֲשָׁשׁ\"", "\"שִׁעֲמוּם גָּדוֹל\"", "\"רְעָבוֹן לֶאֱכֹל מַשֶּׁהוּ\"", "\"שִׂמְחָה עֲצוּמָה\""}, 0, "כַּאֲשֶׁר שׁוֹמְעִים קוֹל לֹא מֻכָּר מֵאֲחוֹרֵי שִׂיחַ בַּיַּעַר, לָרֹב מַרְגִּישִׁים סַקְרָנוּת וַחֲשָׁשׁ מִפְּנֵי מַה שֶּׁמִּסְתַּתֵּר."},
    {1099, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת הַמִּלָּה הֲכִי מַתְאִימָה לְהַשְׁלִים אֶת הַמִּשְׁפָּט: הַפַּרְפַּר מִתְעוֹפֵף מִפֶּרַח לְפֶרַח כְּדֵי _______ צוּף.", {"\"לִשְׁתּוֹת\"", "\"לִכְתּוֹב\"", "\"לָנוּחַ\"", "\"לַעֲצוֹד\""}, 0, "הַפַּרְפָּרִים אוֹסְפִים וְשׁוֹתִים צוף מִתּוֹךְ הַפְּרָחִים."},
    {1100, 1, PROFILE_ETHAN, "מָה הַפֹּעַל הַמַּתְאִים בַּמִּשְׁפָּט לְשׁוֹן רַבִּים: אֶתְמוֹל, יְלָדִים רַבִּים _______ אֶת סִפְרֵי הַקֶּסֶם שֶׁלָּהֶם בַּסִּפְרִיָּה.", {"\"קָרְאוּ\"", "\"קָרָא\"", "\"קָרְאָה\"", "\"קוֹרֵא\""}, 0, "הַמִּלָּה \"יְלָדִים\" הִיא בְּלָשׁוֹן זָכָר רַבִּים. כֵּיוָן שֶׁמְּדֻבָּר בְּעָבָר (\"אֶתְמוֹל\"), הַפֹּעַל הַנָּכוֹן הוּא \"קָרְאוּ\"."},
    {1101, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת צוּרַת הַיָּחִיד שֶׁל הַמִּלָּה גְּלִימוֹת:", {"\"גְּלִימָה\"", "\"גָּלִים\"", "\"גְּלוּם\"", "\"גְּלוּמָה\""}, 0, "צוּרַת הַיָּחִיד שֶׁל \"גְּלִימוֹת\" (נְקֵבָה רַבִּים) הִיא \"גְּלִימָה\" (נְקֵבָה יָחִיד)."},
    {1102, 1, PROFILE_ETHAN, "הַשְׁלִימוּ עִם מִלַּת הַקִּשּׁוּר הַנְּכוֹנָה: יָעֵל רָצְתָה לְשַׂחֵק בַּחוּץ, _______ שֶׁיָּרַד גֶּשֶׁם חָזָק אָז הִיא נִשְׁאֲרָה בַּבַּי…", {"\"אֲבָל\"", "\"בִּגְלַל\"", "\"כְּמוֹ\"", "\"לָכֵן\""}, 0, "הַמִּלָּה \"אֲבָל\" מְצַיֶּנֶת הִתְנַגְּדוּת אוֹ נִגּוּד. הִיא רָצְתָה לָצֵאת, אֲבָל הַגֶּשֶׁם מָנַע בַּעֲדָהּ."},
    {1103, 1, PROFILE_ETHAN, "אֵיזוֹ קְבוּצָה מְכִילָה רַק מִלִּים מִמִּשְׁפַּחַת \"שֹׁרֶשׁ\" צ-ב-ע?", {"\"צָבוּעַ, צִבְעוֹנִי, צֶבַע\"", "\"הִצְבִּיעַ, אֶצְבַּע, צֶבַע\"", "\"מִצְבָּעָה, תּוֹבֵעַ, טוֹבֵעַ\"", "\"צְבִי, מַצָּב, עֶצֶב\""}, 0, "בַּקְּבוּצָה הָרִאשׁוֹנָה מְצוּיוֹת כָּל הַמִּלִּים שֶׁמְּיֻחָסוֹת לַשֹּׁרֶשׁ צ-ב-ע (צֶבַע, לִצְבֹּעַ)."},
    {1104, 1, PROFILE_ETHAN, "מָה הַמִּשְׁמָעוּת שֶׁל הַבִּטּוּי \"קָרָא דְּרוֹר\"?", {"\"שִׁחְרֵר וְנָתַן חֹפֶשׁ\"", "\"שָׁאַג בְּקוֹל רָם\"", "\"קוֹרֵא הַרְבֵּה סְפָרִים בַּסִּפְרִיָּה\"", "\"צָעַק אֶת כָּל אוֹתִיּוֹת הָאָלֶף-בֵּית\""}, 0, "הַבִּטּוּי \"דְּרוֹר\" מַשְׁמָעוּתוֹ חֹפֶשׁ וְחֵרוּת, וְלָכֵן \"לִקְרֹא דְּרוֹר\" מַשְׁמָעוּתוֹ לְשַׁחְרֵר וְלָתֵת חֹפֶשׁ."},
    {1105, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת הַמִּלָּה הַיְחִידָה שֶׁשַּׁיֶּכֶת לַקְּבוּצָה שֶׁל כְּלֵי תַּחְבּוּרָה:", {"\"רַכֶּבֶת\"", "\"כֻּרְסָה\"", "\"מַחְשֵׁב\"", "\"מְעִיל\""}, 0, "רַכֶּבֶת הִיא כְּלִי רֶכֶב הַמְּשַׁמֵּשׁ לְתַחְבּוּרָה וּלְנְסִיעָה מִמָּקוֹם לְמָקוֹם."},
    {1106, 1, PROFILE_ETHAN, "איזו מילה מציינת צבע?", {"כחול", "שולחן", "לרוץ", "שמח"}, 0, "כחול הוא שם של צבע."},
    {1107, 1, PROFILE_ETHAN, "בחרו את המילה שמשלימה את המשפט: הילדים ___ בגינה אתמול.", {"שיחקו", "ישחקו", "משחקים", "לשחק"}, 0, "האירוע קרה בעבר ולכן משתמשים בפועל 'שיחקו'."},
    {1108, 1, PROFILE_ETHAN, "איזו מילה היא מילה הפוכה למילה 'ארוך'?", {"קצר", "גבוה", "רחב", "מהיר"}, 0, "ההפך מארוך הוא קצר."},
    {1109, 1, PROFILE_ETHAN, "מה עושים כשמברכים חבר בברכת 'יום הולדת שמח'?", {"חוגגים ומאחלים לו דברים טובים ליום הולדתו", "כועסים עליו", "מבקשים ממנו עזרה", "הולכים לישון"}, 0, "ברכה נועדה לאחל דברים טובים וחיוביים."},
    {1110, 1, PROFILE_ETHAN, "בחרו את המשפט שכתוב בצורה הנכונה ביותר:", {"הילדה הלכה לבית הספר.", "הילדה הלך לבית הספר.", "הילדה הלכו לבית הספר.", "הילדה הלכת לבית הספר."}, 0, "הילדה (נקבה, יחיד) מתאימה לפועל הלכה."},
    {1111, 1, PROFILE_ETHAN, "איזו מילה שייכת למשפחת המילים של המילה 'סֵפֶר'?", {"ספרייה", "סיפור", "סגור", "שבר"}, 0, "ספרייה היא מקום שבו שומרים ומשאילים ספרים."},
    {1112, 2, PROFILE_ETHAN, "How do you say 'שַׁרְבִיט' in English?", {"Wand", "Book", "Hat", "Owl"}, 0, "שַׁרְבִיט בְּאַנְגְּלִית זֶה Wand."},
    {1113, 2, PROFILE_ETHAN, "Which magical creature is an 'Owl'?", {"יַנְשׁוּף", "חָתוּל", "עַכָּבִישׁ", "דְּרָקוֹן"}, 0, "Owl הוּא יַנְשׁוּף שֶׁמְּבִיא אֶת הַמִּכְתָּבִים בַּאֲקָדֶמְיַת הַקּוֹסְמִים."},
    {1114, 2, PROFILE_ETHAN, "Complete the sentence: The young wizard ___ a student.", {"is", "are", "am", "be"}, 0, "The young wizard is one person, so we use 'is'."},
    {1115, 2, PROFILE_ETHAN, "How do you spell the color of gold in English?", {"Gold", "Silver", "Red", "Blue"}, 0, "זָהָב בְּאַנְגְּלִית זֶה Gold."},
    {1116, 2, PROFILE_ETHAN, "What is a 'Spell' in Wizard Academy?", {"לַחַשׁ קֶסֶם", "סֵפֶר לִמּוּד", "שִׁקּוּי", "מַטְאֲטֵא"}, 0, "Spell הוּא לַחַשׁ קֶסֶם שֶׁמַּטִילִים."},
    {1117, 2, PROFILE_ETHAN, "Which word means 'סֵפֶר'?", {"Book", "Door", "Chair", "Moon"}, 0, "סֵפֶר בְּאַנְגְּלִית הוּא Book."},
    {1118, 2, PROFILE_ETHAN, "Choose the correct sentence:", {"I am a student.", "I is a student.", "I are a student.", "I be a student."}, 0, "With 'I' we use 'am'."},
    {1119, 2, PROFILE_ETHAN, "What is the opposite of big?", {"Small", "Fast", "Long", "Happy"}, 0, "The opposite of 'big' is 'small'."},
    {1120, 2, PROFILE_ETHAN, "Complete the sentence: The owl ___ flying.", {"is", "are", "am", "be"}, 0, "'The owl' is singular, so we use 'is'."},
    {1121, 2, PROFILE_ETHAN, "Which word completes the sentence: 'I have ___ apple'?", {"an", "a", "the two", "are"}, 0, "We use 'an' before a vowel sound."},
    {1122, 2, PROFILE_ETHAN, "What does \"Green\" mean?", {"\"יָרוֹק\"", "\"אָדוֹם\"", "\"כָּחוֹל\"", "\"צָהוֹב\""}, 0, "Green בְּאַנְגְּלִית הוּא הַצֶּבַע הַיָּרוֹק."},
    {1123, 2, PROFILE_ETHAN, "How do you say \"תַּפּוּחַ\" in English?", {"\"Apple\"", "\"Banana\"", "\"Orange\"", "\"Tree\""}, 0, "Apple בְּאַנְגְּלִית זֶה תַּפּוּחַ."},
    {1124, 2, PROFILE_ETHAN, "Choose the right word: I ____ a magic wand.", {"\"have\"", "\"has\"", "\"am\"", "\"doing\""}, 0, "כַּאֲשֶׁר מְדַבְּרִים בְּגוּף רִאשׁוֹן עַל דָּבָר שֶׁיֵּשׁ לָנוּ, אוֹמְרִים \"I have\" (יֵשׁ לִי)."},
    {1125, 2, PROFILE_ETHAN, "What does the sentence \"The cat is black\" mean?", {"\"הֶחָתוּל שָׁחוֹר\"", "\"הַכֶּלֶב קָטָן\"", "\"הֶחָתוּל צָהוֹב\"", "\"יֵשׁ כָּאן חָתוּל וְכֶלֶב\""}, 0, "The cat הוּא \"הֶחָתוּל\" וְ-black הוּא הצבע \"שָׁחוֹר\". לָכֵן - הֶחָתוּל הוּא שָׁחוֹר."},
    {1126, 2, PROFILE_ETHAN, "Translate the word \"School\" to Hebrew:", {"\"בֵּית סֵפֶר\"", "\"פַּארְק\"", "\"בַּיִת\"", "\"כִּתָּה\""}, 0, "School בְּאַנְגְּלִית זֶה בֵּית סֵפֶר."},
    {1127, 2, PROFILE_ETHAN, "What is the opposite of \"Big\"?", {"\"Small\"", "\"Tall\"", "\"Long\"", "\"Fast\""}, 0, "הַמִּלָּה Big (גָּדוֹל) הִיא הַהֵפֶךְ מֵהַמִּלָּה Small (קָטָן)."},
    {1128, 2, PROFILE_ETHAN, "Choose the right number: We have ____ fingers on one hand.", {"\"five\"", "\"four\"", "\"ten\"", "\"three\""}, 0, "יֵשׁ לָנוּ חָמֵשׁ אֶצְבָּעוֹת בְּיָד אַחַת. Five מַשְׁמָעוּתוֹ 5."},
    {1129, 2, PROFILE_ETHAN, "How do you say \"שֶׁמֶשׁ\" in English?", {"\"Sun\"", "\"Moon\"", "\"Star\"", "\"Cloud\""}, 0, "שֶׁמֶשׁ בְּאַנְגְּלִית הִיא Sun."},
    {1130, 2, PROFILE_ETHAN, "Which day comes after Sunday?", {"\"Monday\"", "\"Tuesday\"", "\"Friday\"", "\"Saturday\""}, 0, "Sunday הוּא יוֹם רִאשׁוֹן. הַיּוֹם שֶׁבָּא אַחֲרָיו הוּא Monday (יוֹם שֵׁנִי)."},
    {1131, 2, PROFILE_ETHAN, "Translate: \"Good morning!\"", {"\"בֹּקֶר טוֹב!\"", "\"לַיְלָה טוֹב!\"", "\"הִתְרָאוֹת!\"", "\"מָה הָשָּׁעָה?\""}, 0, "הַבִּטּוּי Good morning פֵּרוּשׁוֹ בֹּקֶר טוֹב (Good = טוֹב, Morning = בֹּקֶר)."},
    {1132, 3, PROFILE_ETHAN, "מָהִי מַטְרַת מִצְוַת הַצְּדָקָה?", {"לַעֲזֹר וּלְשַׂמֵּחַ אַנָשִׁים שֶׁזְּקוּקִים לְסִ…", "לִקְנוֹת צַעֲצוּעִים לְעַצְמֵנוּ", "לִבְנוֹת טִירַות קְסָמִים", "לִלְמֹד לְחָשִׁים חֲדָשִׁים"}, 0, "צְדָקָה הִיא מַתַּן עֶזְרָה לָאֵלּוּ שֶׁאֵין בִיכָלְתָּם לְכַלְכֵּל אֶת עַצְמָם."},
    {1133, 3, PROFILE_ETHAN, "מָה מְיַחֵד אֶת יוֹם הַשַּׁבָּת?", {"זֶהוּ יוֹם מְנוּחָה מִשְׁפַּחְתִּי לְלֹא מְלָאכָה", "זֶהוּ יוֹם שֶׁבּוֹ עוֹבְדִים יוֹתֵר קָשֶׁה", "בְּיוֹם זֶה יוֹצְאִים לִקְנִיּוֹת בַּשּׁוּק", "זֶהוּ יוֹם מְיֻחָד לְהֲכָנַת שִׁקּוּיִים רְעִילִים"}, 0, "הַשַּׁבָּת נוֹעֲדָה לִמְנוּחָה, לִקְדֻשָּׁה וּלְבִלּוּי מְשֻׁתָּף עִם הַמִּשְׁפָּחָה."},
    {1134, 3, PROFILE_ETHAN, "מָתַי מִתְחִילָה הַשַּׁבָּת?", {"בְּעֶרֶב יוֹם שִׁשִּׁי", "בְּשַׁבָּת בַּצָּהֳרַיִם", "בְּיוֹם רִאשׁוֹן בַּבֹּקֶר", "בְּיוֹם חֲמִישִׁי בָּעֶרֶב"}, 0, "הַשַּׁבָּת מִתְחִילָה בִּשְׁקִיעַת הַחַמָּה בְּעֶרֶב יוֹם שִׁשִּׁי."},
    {1135, 3, PROFILE_ETHAN, "מַדּוּעַ מְבָרְכִים לִפְנֵי שֶׁאוֹכְלִים?", {"כְּדֵי לְהוֹדוֹת עַל הַמָּזוֹן", "כְּדֵי שֶׁהָאוֹכֶל יִתְקָרֵר", "כְּדֵי לִסְפֹּר אֶת הַצַּלַּחוֹת", "כְּדֵי לְסַיֵּם מַהֵר"}, 0, "הַבְּרָכָה מְבַטֵּאת תּוֹדָה לַה' עַל הַמָּזוֹן."},
    {1136, 3, PROFILE_ETHAN, "אֵיזוֹ פְּעֻלָּה הִיא דֻּגְמָה לְכִבּוּד הוֹרִים?", {"לַעֲזֹר בַּבַּיִת וּלְדַבֵּר בְּכָבוֹד", "לְהִתְעַלֵּם מִכָּל בַּקָּשָׁה", "לִצְעֹק כַּאֲשֶׁר לֹא מַסְכִּימִים", "לָקַחַת דָּבָר בְּלִי רְשׁוּת"}, 0, "עֶזְרָה וְדִבּוּר מְכַבֵּד הֵם דְּרָכִים לְקַיֵּם כִּבּוּד הוֹרִים."},
    {1137, 3, PROFILE_ETHAN, "מָהִי הַמַּטָּרָה שֶׁל בִּקּוּר חוֹלִים?", {"לְעוֹדֵד וְלַעֲזֹר לָאָדָם הַחוֹלֶה", "לִבְקֵשׁ מִמֶּנּוּ שִׁעוּרֵי בַּיִת", "לְהַרְעִישׁ בְּחַדְרוֹ", "לָקַחַת אֶת הַתְּרוּפוֹת שֶׁלּוֹ"}, 0, "בִּקּוּר חוֹלִים נוֹעַד לִתְמֹךְ בַּחוֹלֶה וְלַעֲזֹר לוֹ."},
    {1138, 3, PROFILE_ETHAN, "אֵיזֶה מַאֲכָל מְזֹהָה מְיֻחָד עִם חַג הַפֶּסַח?", {"מַצָּה", "סֻפְגָּנִיָּה", "אֹזֶן הָמָן", "תַּפּוּחַ בִּדְבַשׁ"}, 0, "בְּפֶסַח אוֹכְלִים מַצָּה לְזֵכֶר יְצִיאַת מִצְרַיִם."},
    {1139, 3, PROFILE_ETHAN, "בְּאֵיזֶה כְּלִי נוֹהֲגִים לִתְקֹעַ בְּרֹאשׁ הַשָּׁנָה?", {"שׁוֹפָר", "כִּנּוֹר", "חָלִיל", "תֹּף"}, 0, "תְּקִיעַת הַשּׁוֹפָר הִיא אַחַת הַמִּצְוֹת הַמֶּרְכָּזִיּוֹת שֶׁל רֹאשׁ הַשָּׁנָה."},
    {1140, 3, PROFILE_ETHAN, "מָתַי עוֹרְכִים הַבְדָּלָה?", {"בְּמוֹצָאֵי שַׁבָּת", "בְּיוֹם שִׁשִּׁי בַּבֹּקֶר", "בְּאֶמְצַע יוֹם שַׁבָּת", "בְּיוֹם שֵׁנִי בָּעֶרֶב"}, 0, "הַבְדָּלָה נֶאֱמֶרֶת בְּצֵאת הַשַּׁבָּת."},
    {1141, 3, PROFILE_ETHAN, "מָה נָכוֹן לַעֲשׂוֹת לִפְנֵי שֶׁמְּסַפְּרִים דָּבָר שֶׁעָלוּל לִפְגֹּעַ בְּחָבֵר?", {"לַעֲצֹר וְלֹא לְהָפִיץ אֶת הַדָּבָר", "לְסַפֵּר לְכַמָּה שֶׁיּוֹתֵר אַנָשִׁים", "לִכְתֹּב אוֹתוֹ בַּקְּבוּצָה", "לְהוֹסִיף פְּרָטִים מַצְחִיקִים"}, 0, "נִמְנָעִים מִדִּבּוּר שֶׁעָלוּל לְבַיֵּשׁ אוֹ לִפְגֹּעַ בְּאָדָם אַחֵר."},
    {1142, 3, PROFILE_ETHAN, "בְּאֵיזֶה חַג נוֹהֲגִים לִשְׁמֹעַ אֶת קוֹל הַשּׁוֹפָר בְּבֵית הַכְּנֶסֶת?", {"\"רֹאשׁ הַשָּׁנָה\"", "\"פֶּסַח\"", "\"סֻכּוֹת\"", "\"שָׁבוּעוֹת\""}, 0, "בְּרֹאשׁ הַשָּׁנָה מִצְוָה לִשְׁמֹעַ תְּקִיעַת שׁוֹפָר כְּסִימָן לְהִתְעוֹרְרוּת לִקְרַאת שָׁנָה חֲדָשָׁה וְטוֹבָה."},
    {1143, 3, PROFILE_ETHAN, "עַל פִּי הַמָּסֹרֶת, בְּאֵיזֶה מָקוֹם קִבְּלוּ בְּנֵי יִשְׂרָאֵל אֶת הַתּוֹרָה?", {"\"בְּהַר סִינַי\"", "\"בְּאֶרֶץ מִצְרַיִם\"", "\"בְּיְרוּשָׁלַיִם\"", "\"עַל הַיָּם\""}, 0, "מַעֲמַד מַתַּן תּוֹרָה הִתְרַחֵשׁ עַל הַר סִינַי בַּמִּדְבָּר."},
    {1144, 3, PROFILE_ETHAN, "מָה נָהוּג לַעֲשׂוֹת בְּחַג הַסֻּכּוֹת?", {"\"לֶאֱכֹל וְלָשֶׁבֶת בְּסֻכָּה\"", "\"לֶאֱכֹל מַצּוֹת בַּבַּיִת\"", "\"לְהַדְלִיק חֲנֻכִּיָּה בַּחַלּוֹן\"", "\"לָצוּם כָּל הַיּוֹם\""}, 0, "מִצְוָת חַג הַסֻּכּוֹת הִיא לֵישֵׁב, לֶאֱכֹל וּלְאָרֵחַ בְּתוֹךְ סֻכָּה שֶׁהֵכַנּוּ מֵרֹאשׁ."},
    {1145, 3, PROFILE_ETHAN, "בְּאֵיזֶה מֵהַחַגִּים אֲנַחְנוּ חוֹגְגִים אֶת מַתַּן תּוֹרָה וְנוֹהֲגִים לֶאֱכֹל מַאֲכָלֵי חָלָב?", {"\"חַג הַשָּׁבוּעוֹת\"", "\"חַג הַפֶּסַח\"", "\"חַג פוּרִים\"", "\"יוֹם הַכִּפּוּרִים\""}, 0, "חַג הַשָּׁבוּעוֹת הוּא הֶחָג בּוֹ נִתְּנָה הַתּוֹרָה, וּמִנְהָג יָדוּעַ לֶאֱכֹל בּוֹ אֲרוּחוֹת עִם מַאֲכָלֵי חָלָב שׁוֹנִים."},
    {1146, 3, PROFILE_ETHAN, "מִי מֵהַבָּאִים **אֵינוֹ** נִמְנֶה עִם אַרְבַּעַת הַמִּינִים מֵחַג סֻכּוֹת?", {"\"תַּפּוּחַ עֵץ\"", "\"אֶתְרוֹג\"", "\"לוּלָב\"", "\"הֲדַס\""}, 0, "אַרְבַּעַת הַמִּינִים הֵם אֶתְרוֹג, לוּלָב, הֲדַס וַעֲרָבָה. מִכָּאן שֶׁתַּפּוּחַ עֵץ הוּא לֹא אֶחָד מֵהֶם."},
    {1147, 3, PROFILE_ETHAN, "מִי הָיְתָה הַדְּמוּת הַיְּדוּעָה בַּתּוֹרָה בְּכָךְ שֶׁהָיָה לָהּ אֹהֶל פָּתוּחַ לְכָל כִּוּוּנָיו, וְדָאֲגָה לְקַבֵּל אֶת פְּנֵי שְׁלֹשֶׁ…", {"\"אַבְרָהָם אָבִינוּ\"", "\"דָּוִד הַמֶּלֶךְ\"", "\"משֶׁה רַבֵּנוּ\"", "\"נוֹחַ\""}, 0, "אַבְרָהָם אָבִינוּ מֻכָּר כְּסִמְלָהּ הַגָּדוֹל שֶׁל מִצְוַת הַכְנָסַת אוֹרְחִים בְּזְכוּת מַאֲמָצָיו לְקַבֵּל אֶת הָעוֹבְרִים וְהַשָּׁבִים אֶל אֹהָלוֹ."},
    {1148, 3, PROFILE_ETHAN, "כַּמָּה יָמִים חוֹגְגִים אֶת חַג חֲנֻכָּה וּמַדְלִיקִים נֵרוֹת בַּחֲנֻכִּיָּה?", {"\"שְׁמוֹנָה יָמִים\"", "\"שִׁבְעָה יָמִים\"", "\"אַרְבָּעָה יָמִים\"", "\"אָסוּר לְהַדְלִיק נֵרוֹת בַּחֲנֻכָּה\""}, 0, "נֵס פַּךְ הַשֶּׁמֶן הִסְפִּיק לִשְׁמוֹנָה יָמִים, וְלָכֵן חַג חֲנֻכָּה נִמְשָׁךְ 8 יָמִים."},
    {1149, 3, PROFILE_ETHAN, "לִפְנֵי שֶׁיּוֹשְׁבִים וְאוֹכְלִים אֲרוּחָה עִם לֶחֶם, מָה נָהוּג לַעֲשׂוֹת?", {"\"לִטּוֹל יָדַיִם וּלְבָרֵךְ עַל נְטִילַת יָדַיִם\"", "\"לִסְפֹּר עַד מֵאָה בְּשֶׁקֶט\"", "\"לְהָכִין מְרַק בָּצָל\"", "\"לְהַדְלִיק מְדוּרָה קְטַנָּה בַּחֲצַר\""}, 0, "עַל פִּי מָסֹרֶת יִשְׂרָאֵל, לִפְנֵי אֲכִילַת פַּת (לֶחֶם) מִצְוָה עָלֵינוּ לִטּוֹל אֶת הַיָּדַיִם בְּנַטְלָה שֶׁתַּכְשִׁיר אוֹתָנוּ לַאֲרוּחָה קְדוֹשָׁה."},
    {1150, 3, PROFILE_ETHAN, "בְּאֵיזֶה זְמַן אֲנַחְנוּ צְרִיכִים לִקְרֹא \"קְרִיאַת שְׁמַע\" לְפִי הַמִּצְוָה הָרְגִילָה?", {"\"בַּבֹּקֶר וּבָעֶרֶב (לִפְנֵי שֶׁיְּשֵׁנִים)\"", "\"רַק בַּצָּהֳרַיִם הַמְּאֻחָרִים\"", "\"כַּאֲשֶׁר לֹא מַרְגִּישִׁים טוֹב טוֹב\"", "\"כַּאֲשֶׁר קוֹנִים נַעֲלַיִם חֲדָשׁוֹת\""}, 0, "מִצְוָה מִן הַתּוֹרָה לִקְרֹא שְׁמַע פַּעֲמַיִם בַּיּוֹם – בַּשְׁכָּמָה בַּבֹּקֶר וּבְעֵת הַשֵּׁנָה (\"בְּשָׁכְבְּךָ וּבְקוּמֶךָ\")."},
