    {1103, 1, PROFILE_ETHAN, "אֵיזוֹ קְבוּצָה מְכִילָה רַק מִלִּים מִמִּשְׁפַּחַת \"שֹׁרֶשׁ\" צ-ב-ע?", {"\"מִצְבָּעָה, תּוֹבֵעַ, טוֹבֵעַ\"", "\"הִצְבִּיעַ, אֶצְבַּע, צֶבַע\"", "\"צָבוּעַ, צִבְעוֹנִי, צֶבַע\"", "\"צְבִי, מַצָּב, עֶצֶב\""}, 2, "בַּקְּבוּצָה הָרִאשׁוֹנָה מְצוּיוֹת כָּל הַמִּלִּים שֶׁמְּיֻחָסוֹת לַשֹּׁרֶשׁ צ-ב-ע (צֶבַע, לִצְבֹּעַ).", "", 1},
    {1104, 1, PROFILE_ETHAN, "מָה הַמִּשְׁמָעוּת שֶׁל הַבִּטּוּי \"קָרָא דְּרוֹר\"?", {"\"שָׁאַג בְּקוֹל רָם\"", "\"שִׁחְרֵר וְנָתַן חֹפֶשׁ\"", "\"קוֹרֵא הַרְבֵּה סְפָרִים בַּסִּפְרִיָּה\"", "\"צָעַק אֶת כָּל אוֹתִיּוֹת הָאָלֶף-בֵּית\""}, 1, "הַבִּטּוּי \"דְּרוֹר\" מַשְׁמָעוּתוֹ חֹפֶשׁ וְחֵרוּת, וְלָכֵן \"לִקְרֹא דְּרוֹר\" מַשְׁמָעוּתוֹ לְשַׁחְרֵר וְלָתֵת חֹפֶשׁ.", "", 1},
    {1105, 1, PROFILE_ETHAN, "בַּחֲרוּ אֶת הַמִּלָּה הַיְחִידָה שֶׁשַּׁיֶּכֶת לַקְּבוּצָה שֶׁל כְּלֵי תַּחְבּוּרָה:", {"\"רַכֶּבֶת\"", "\"כֻּרְסָה\"", "\"מַחְשֵׁב\"", "\"מְעִיל\""}, 0, "רַכֶּבֶת הִיא כְּלִי רֶכֶב הַמְּשַׁמֵּשׁ לְתַחְבּוּרָה וּלְנְסִיעָה מִמָּקוֹם לְמָקוֹם.", "", 1},
