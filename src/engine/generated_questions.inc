    {1122, 2, PROFILE_ETHAN, "What does \"Green\" mean?", {"\"צָהוֹב\"", "\"אָדוֹם\"", "\"כָּחוֹל\"", "\"יָרוֹק\""}, 3, "Green בְּאַנְגְּלִית הוּא הַצֶּבַע הַיָּרוֹק.", "", 2},
