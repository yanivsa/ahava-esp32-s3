    {1152, 0, PROFILE_ORI, "פתרו את המשוואה הבאה: 3x + 7 = 22. מהו ערכו של x?", {"5", "3", "7", "4"}, 0, "נחסר 7 משני אגפי המשוואה ונקבל 3x = 15. נחלק ב-3 ונקבל x = 5."},
